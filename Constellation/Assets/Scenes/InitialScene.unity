  Jojak: {fileID: 1173751559}
  Lever: {fileID: 1082934822}
  typingSpeed: 0.1
  soundInterval: 1
  delayBetweenLines: 2
  scenarioLines:
  - "\uC5EC\uAE30\uB294 WJ25, \n\uD604\uC7AC \uC131\uC6B4 \uC740\uD558 \uD0DC\uC591\uACC4\uC5D0
    \uD751\uC810 \uD3ED\uBC1C \uC601\uD5A5\uC73C\uB85C 4\uAC1C\uC758 \uBCC4\uC790\uB9AC
    \uD615\uC0C1 \uBCC0\uD658\uC774 \uBC1C\uC0DD\uD588\uC74C\uC744 \uC54C\uB9BC. "
  - "\uC138\uC774\uBE44\uC5B4\uB294 \uC870\uC18D\uD788 \uD0C0\uAC9F \uD3EC\uC778\uD2B8\uB85C
    \uC774\uB3D9\uD558\uC5EC \uBE5B\uC758 \uACBD\uB85C\uB97C \uC7AC\uC124\uC815 \uBC14\uB78C."
  - "<<\uC138\uACC4\uAD00>>\n\uC6B0\uB9AC\uAC00 \uC0B4\uACE0 \uC788\uB294 \uC740\uD558\uC640
    \uB2E4\uB978 \uC131\uC6B4 \uC740\uD558\uC758 \uD0DC\uC591\uACC4\uC5D0\uC11C \uD751\uC810
    \uD3ED\uBC1C\uB85C \uC778\uD574 \uC5D0\uB108\uC9C0\uC758 \uC6D0\uCC9C\uC778 \"\uBCC4\uBB34\uB9AC\"\uAC00
    \uBE5B\uC744 \uC783\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4. "
  - "<<\uC138\uACC4\uAD00>>\n\uB2F9\uC2E0\uC740 \uC131\uC6B4 \uC740\uD558\uB97C \uAD6C\uD574\uC904
    \uBE5B\uC758 \uC138\uC774\uBE44\uC5B4 \uC785\uB2C8\uB2E4. \uBE5B\uC744 \uC783\uC740
    4\uAC1C\uC758 \uBCC4\uBB34\uB9AC\uB97C \uC62C\uBC14\uB978 \uBE5B\uC758 \uACBD\uB85C\uB85C
    \uC124\uACC4\uD558\uC5EC \uBE5B\uC744 \uB418\uCC3E\uC544 \uC8FC\uC138\uC694."
  - "\uD604\uC7AC \uD50C\uB808\uC774\uD558\uC2DC\uB294 \uBC84\uC804\uC740 \uB370\uBAA8
    \uBC84\uC804\uC73C\uB85C \uBC84\uADF8\uAC00 \uC0DD\uAE38 \uC218 \uC788\uB294
    \uC810 \uC591\uD574 \uBC14\uB78D\uB2C8\uB2E4."
  - "\uBC84\uADF8 \uB9AC\uD3EC\uD2B8\uB294 \uAC1C\uBC1C\uC790\uC5D0\uAC8C \uD070
    \uB3C4\uC6C0\uC774 \uB429\uB2C8\uB2E4. \uB9CE\uC740 \uD53C\uB4DC\uBC31 \uBC14\uB78D\uB2C8\uB2E4."
